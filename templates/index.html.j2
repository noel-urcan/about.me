<style>
@font-face { font-family: 'Playfair Display'; font-style: normal; font-weight: 400; font-display: swap; src: url('fonts/playfair-display-400.woff2') format('woff2'); }
@font-face { font-family: 'Playfair Display'; font-style: italic; font-weight: 400; font-display: swap; src: url('fonts/playfair-display-400-italic.woff2') format('woff2'); }
@font-face { font-family: 'DM Sans'; font-style: normal; font-weight: 300; font-display: swap; src: url('fonts/dm-sans-300.woff2') format('woff2'); }
@font-face { font-family: 'DM Sans'; font-style: normal; font-weight: 400; font-display: swap; src: url('fonts/dm-sans-400.woff2') format('woff2'); }
@font-face { font-family: 'DM Sans'; font-style: normal; font-weight: 500; font-display: swap; src: url('fonts/dm-sans-500.woff2') format('woff2'); }
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root { --bg: #F7F5F0; --card: #FFFFFF; --text: #1A1A1A; --muted: #6B6B6B; --border: #E4E0D8; --accent-light: #F0EDE8; }
body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text); overflow-x: hidden; }
nav { background: var(--card); border-bottom: 0.5px solid var(--border); padding: 14px 32px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 100; }
.nav-name { font-family: 'Playfair Display', serif; font-size: 15px; font-weight: 400; text-decoration: none; color: var(--text); }
.nav-links { display: flex; gap: 24px; list-style: none; }
.nav-links a { font-size: 12px; color: var(--muted); text-decoration: none; transition: color 0.2s; }
.nav-links a:hover { color: var(--text); }

/* HERO */
.hero { background: var(--card); padding: 48px 32px 40px 20%; border-bottom: 0.5px solid var(--border); }
.hero-viewport { min-height: calc(100vh - 47px); display: flex; flex-direction: column; }
.hero-viewport .hero { flex: 1 0 auto; }

.press-bar { background: var(--card); margin-top: 1px; padding: 14px 32px; border-bottom: 0.5px solid var(--border); display: flex; align-items: center; justify-content: center; gap: 8px; }
.press-logos { display: flex; align-items: center; gap: 6px; flex-shrink: 0; padding-bottom: 4px; }
.press-logos-label { font-size: 9px; color: var(--muted); white-space: nowrap; margin-right: 2px; }
.press-logo-box { height: 16px; width: 52px; display: flex; align-items: center; justify-content: center; }
.press-logo { max-height: 100%; max-width: 100%; width: auto; height: auto; object-fit: contain; display: block; opacity: 0.85; }
@media (max-width: 680px) { .press-bar { padding: 12px 20px; } }

.hero-tag { font-size: 10px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
.hero-name { font-family: 'Playfair Display', serif; font-size: 52px; font-weight: 400; line-height: 1.0; letter-spacing: -0.02em; margin-bottom: 28px; }
.hero-body { display: grid; grid-template-columns: 320px 1fr; gap: 32px; align-items: start; }
.photo-col { display: flex; flex-direction: column; gap: 8px; }
.photo-wrap { width: 320px; overflow: hidden; border: 0.5px solid var(--border); flex-shrink: 0; }
.photo-wrap img { width: 100%; display: block; object-fit: cover; object-position: center top; }

/* Social Buttons — Alex Grantl Stil */
.social { display: flex; gap: 5px; width: 320px; }
.social-btn { flex: 1; height: 34px; border-radius: 2px; border: 0.5px solid var(--border); background: var(--card); display: flex; align-items: center; justify-content: center; gap: 5px; text-decoration: none; transition: background 0.15s; color: var(--text); }
.social-btn:hover { background: var(--accent-light); }
.social-btn svg { width: 12px; height: 12px; stroke: var(--text); fill: none; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
.social-btn span { font-size: 10px; font-weight: 500; white-space: nowrap; }

/* Bio */
.hero-bio { font-size: 13px; font-weight: 300; line-height: 1.85; color: var(--muted); max-width: 480px; }
.hero-bio a { color: var(--text); text-decoration: none; border-bottom: 0.5px solid var(--border); transition: border-color 0.2s; }
.hero-bio a:hover { border-color: var(--text); }

/* SECTION */
.section { background: var(--card); margin-top: 1px; padding: 40px 32px; display: flex; flex-direction: column; align-items: center; }
.section-title { font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 400; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 0.5px solid var(--border); width: 100%; max-width: 580px; text-align: center; }
.articles-block { max-width: 580px; margin: 0 auto; }

/* Artikel Cards */
.article-card { display: grid; grid-template-columns: 1fr 160px; gap: 16px; padding: 18px 0; border-bottom: 0.5px solid var(--border); align-items: start; }
.article-card:last-of-type { border-bottom: none; }
.card-body { display: flex; flex-direction: column; gap: 6px; }
.art-header { display: flex; align-items: center; gap: 7px; }
.logo-k { height: 18px; width: 18px; object-fit: contain; }
.art-meta { font-size: 10px; color: var(--muted); letter-spacing: 0.03em; }
.art-title { font-family: 'Playfair Display', serif; font-size: 16px; font-weight: 400; line-height: 1.35; }
.art-teaser { font-size: 12px; color: var(--muted); line-height: 1.65; font-weight: 300; }
.art-links { display: flex; align-items: center; gap: 8px; margin-top: 4px; }
.btn-read { font-size: 11px; font-weight: 500; color: var(--text); padding: 4px 12px; border: 0.5px solid var(--text); border-radius: 2px; background: transparent; cursor: pointer; text-decoration: none; transition: background 0.15s; }
.btn-read:hover { background: var(--accent-light); }
.art-ext { font-size: 10px; color: var(--muted); text-decoration: none; display: inline-flex; align-items: center; gap: 3px; }
.art-ext:hover { color: var(--text); }
.card-img { width: 160px; height: 110px; object-fit: cover; display: block; flex-shrink: 0; }

/* extra3 Block */
.media-card { display: grid; grid-template-columns: 1fr 160px; gap: 16px; padding: 18px 0; border-bottom: 0.5px solid var(--border); align-items: start; }
.media-card:last-of-type { border-bottom: none; }
.media-body { display: flex; flex-direction: column; gap: 6px; }
.media-title { font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 400; }
.media-title a { color: var(--text); text-decoration: none; border-bottom: 0.5px solid var(--border); }
.media-title a:hover { border-color: var(--text); }
.media-sub { font-size: 11px; font-weight: 500; color: var(--text); }
.media-desc { font-size: 12px; color: var(--muted); line-height: 1.6; font-weight: 300; }
.media-img { width: 160px; height: 90px; object-fit: cover; display: block; flex-shrink: 0; }

/* Kontakt */
.contact-section { background: var(--card); margin-top: 1px; padding: 40px 32px 64px; display: flex; flex-direction: column; align-items: center; }
.contact-title { font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 400; margin-bottom: 24px; padding-bottom: 10px; border-bottom: 0.5px solid var(--border); width: 680px; text-align: center; }
.form-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px; width: 680px; }
.form-label { font-size: 10px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
.form-input, .form-textarea { padding: 9px 11px; border: 0.5px solid var(--border); border-radius: 2px; background: var(--bg); font-family: 'DM Sans', sans-serif; font-size: 13px; color: var(--text); outline: none; transition: border-color 0.2s; width: 100%; display: block; }
.form-input:focus, .form-textarea:focus { border-color: var(--text); }
.form-textarea { resize: vertical; min-height: 100px; }
.form-submit { padding: 9px 24px; background: var(--text); color: #fff; border: none; border-radius: 2px; font-family: 'DM Sans', sans-serif; font-size: 12px; font-weight: 500; cursor: pointer; transition: opacity 0.2s; width: 680px; }
.form-submit:hover { opacity: 0.85; }
footer { padding: 16px 32px; text-align: center; font-size: 11px; color: var(--muted); border-top: 0.5px solid var(--border); background: var(--card); margin-top: 1px; }
@media (max-width: 680px) {
  .hero { padding: 32px 20px; }
  .hero-name { font-size: 36px; }
  .hero-body { grid-template-columns: 1fr; }
  .photo-wrap, .social { width: 100%; }
  .articles-block { max-width: 100%; }
  .article-card, .media-card { grid-template-columns: 1fr; }
  .card-img, .media-img { width: 100%; height: 160px; }
  .img-credit-wrap { width: 100%; height: 160px; }
  .section, .contact-section { padding-left: 20px; padding-right: 20px; }
  .contact-title, .form-group, .form-submit { width: 100% !important; }
  .contact-section { display: block !important; }
  .form-input, .form-textarea { width: 100% !important; box-sizing: border-box; }
}

.img-credit-wrap { position: relative; display: inline-block; width: 160px; height: 110px; flex-shrink: 0; }
.img-credit-wrap .card-img { width: 100%; height: 100%; }
.img-credit-wrap .credit-label { position: absolute; bottom: 0; left: 0; right: 0; background: rgba(0,0,0,0.6); color: #fff; font-size: 9px; padding: 3px 5px; opacity: 0; transition: opacity 0.2s; pointer-events: none; line-height: 1.3; }
.img-credit-wrap:hover .credit-label { opacity: 1; }
</style>
</head>
