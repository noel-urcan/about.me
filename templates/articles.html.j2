      <h1 class="page-title">Ausgewählte Arbeitsproben</h1>
    </div>
    <div class="press-logos">
      <span class="press-logos-label">Ver&ouml;ffentlicht u. a. in</span>{% for m in presseleiste %}<span class="press-logo-box"><img class="press-logo press-logo-{{ m.kuerzel }}" src="assets/img/logos/{{ m.logo }}" alt="{{ m.anzeigename }}"></span>{% endfor %}
    </div>
  </div>
</div>

